# Rust build artifacts — never ship these into the build context
target/
**/target/

# Local environment / secrets
.env
.env.*
!.env.example

# Editor / OS junk
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Git
.git/
.gitignore
.gitattributes

# Documentation / scratch
*.log
*.tmp
*.bak

# Docker assets that don't need to be in the build context
docker-compose*.yml
Dockerfile*
.dockerignore
